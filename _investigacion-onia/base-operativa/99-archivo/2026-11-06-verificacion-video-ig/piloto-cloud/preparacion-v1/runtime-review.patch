--- /dev/null
+++ b/tools/omni/pilot-sync.inc
@@ -0,0 +1,179 @@
+// Included in omni.cpp, immediately before stream_prefill. No external API or
+// installer; calls the pinned local decoders, encoders and injection functions.
+// One fresh context/process per case, simplex CPU/no-TTS; no VAD.
+static bool pilot_fail(omni_context * ctx, int chunk, const char * reason) {
+    auto & p = ctx->pilot;
+    p.failed = true;
+    p.error = reason;
+    if (chunk >= 0 && chunk < (int)p.chunks.size()) p.chunks[chunk].error = reason;
+    fprintf(stderr, "PILOT_ERROR {\"chunk\":%d,\"error\":\"%s\",\"n_past\":%d}\n",
+            chunk, reason, ctx->n_past);
+    return false;
+}
+
+static void pilot_text(omni_context * ctx, const std::string & text, int chunk,
+                       bool special, const std::string & modality = "control") {
+    OmniPilotSegment segment;
+    segment.modality = modality;
+    segment.chunk = chunk;
+    segment.tokens = common_tokenize(ctx->ctx_llama, text, false, special);
+    segment.positions = (int)segment.tokens.size();
+    ctx->pilot.prompt_positions += segment.positions;
+    ctx->pilot.segments.push_back(std::move(segment));
+}
+
+static bool pilot_sync_prefill(omni_context * ctx, const std::string & audio_path,
+                               const std::string & image_path, int index,
+                               int max_slices, const std::string & text) {
+    auto & p = ctx->pilot;
+    if (p.failed) return false;
+    if (ctx->async || ctx->duplex_mode || ctx->use_tts || p.committed || p.complete)
+        return pilot_fail(ctx, -1, "unsupported_mode_or_reused_context");
+    if (index == 0) {
+        if (p.initialized || ctx->n_past != 0 || !audio_path.empty() || !image_path.empty() || !text.empty()
+                || p.expected_chunks <= 0 || p.response_limit <= 0)
+            return pilot_fail(ctx, -1, "invalid_init_or_dirty_context");
+        p.chunks.resize(p.expected_chunks);
+        for (auto & c : p.chunks) { c.audio.expected = 1; c.image.expected = 1; }
+        p.chunks.back().text.expected = 1;
+        // Tokenize and STAGE only. No KV insertion until ALL signal is encoded
+        // and signal+literal prompt+control tokens+response budget is known.
+        pilot_text(ctx, "<|im_start|>system\nYou are a helpful assistant.<|im_end|>\n<|im_start|>user\n", -1, true);
+        p.initialized = true;
+        ctx->system_prompt_initialized = true;
+        return true;
+    }
+    const int chunk = index - 1;
+    if (!p.initialized || chunk != p.staged_chunks || chunk >= p.expected_chunks
+            || audio_path.empty() || image_path.empty() || !ctx->ctx_audio || !ctx->ctx_vision)
+        return pilot_fail(ctx, chunk, "missing_pair_or_out_of_order");
+    auto & audit = p.chunks[chunk];
+    // A path delivered to a decoder is NOT decoded/encoded/accepted work.
+    audit.image.delivered = 1;
+    std::vector<uint8_t> image_bytes;
+    if (!audition_read_binary_file(image_path.c_str(), &image_bytes))
+        return pilot_fail(ctx, chunk, "image_read_failed");
+    std::unique_ptr<vision_image_u8, decltype(&vision_image_u8_free)> image(
+        vision_image_u8_init(), vision_image_u8_free);
+    if (!vision_image_load_from_bytes(image_bytes.data(), image_bytes.size(), image.get()))
+        return pilot_fail(ctx, chunk, "image_decode_failed");
+    audit.image.decoded = 1;
+    if (max_slices >= 1) vision_set_max_slice_nums(ctx->ctx_vision, max_slices);
+    std::vector<std::vector<float>> vision_chunks;
+    if (!encode_image_with_vision_chunks(ctx->ctx_vision, 2, image.get(), vision_chunks)
+            || vision_chunks.empty())
+        return pilot_fail(ctx, chunk, "vision_encoder_failed");
+    audit.image.encoder_ok = 1;
+    const int hidden = llama_n_embd(llama_get_model(ctx->ctx_llama));
+    if (hidden <= 0) return pilot_fail(ctx, chunk, "invalid_hidden_size");
+    pilot_text(ctx, "<unit><image>", chunk, true);
+    for (size_t i = 0; i < vision_chunks.size(); ++i) {
+        if (vision_chunks[i].empty() || vision_chunks[i].size() % hidden != 0)
+            return pilot_fail(ctx, chunk, "vision_embedding_shape");
+        if (i > 0) pilot_text(ctx, "<slice>", chunk, true);
+        OmniPilotSegment segment;
+        segment.modality = "image"; segment.chunk = chunk;
+        segment.positions = (int)(vision_chunks[i].size() / hidden);
+        segment.embedding = std::move(vision_chunks[i]);
+        audit.image.encoded_positions += segment.positions;
+        p.segments.push_back(std::move(segment));
+        pilot_text(ctx, i == 0 ? "</image>" : "</slice>", chunk, true);
+    }
+    if (vision_chunks.size() > 1) pilot_text(ctx, "\n", chunk, true);
+
+    audit.audio.delivered = 1;
+    std::unique_ptr<audition_audio_u8, decltype(&audition_audio_u8_free)> audio(
+        audition_audio_u8_init(), audition_audio_u8_free);
+    if (!audition_read_binary_file(audio_path.c_str(), &audio->buf))
+        return pilot_fail(ctx, chunk, "audio_read_failed");
+    audition_audio_f32 * mel_raw = audition_audio_f32_init();
+    const bool preprocessed = audition_audio_preprocess(ctx->ctx_audio, audio.get(), &mel_raw,
+                                                       &audit.audio.decoded_samples);
+    std::unique_ptr<audition_audio_f32, decltype(&audition_audio_f32_free)> mel(
+        mel_raw, audition_audio_f32_free);
+    audit.audio.decoded = audit.audio.decoded_samples > 0 ? 1 : 0;
+    if (!preprocessed || !audit.audio.decoded)
+        return pilot_fail(ctx, chunk, "audio_decode_or_preprocess_failed");
+    // Upstream pads to 100 ms. Reject rather than silently change the signal.
+    if (audit.audio.decoded_samples < 1600 || audit.audio.decoded_samples % 1600 != 0)
+        return pilot_fail(ctx, chunk, "undeclared_audio_padding");
+    if (audition_n_mmproj_embd(ctx->ctx_audio) != hidden)
+        return pilot_fail(ctx, chunk, "audio_embedding_shape");
+    OmniPilotSegment segment;
+    segment.modality = "audio"; segment.chunk = chunk;
+    segment.positions = audition_n_output_tokens(ctx->ctx_audio, mel.get());
+    if (segment.positions <= 0) return pilot_fail(ctx, chunk, "empty_audio_embedding");
+    segment.embedding.resize((size_t)hidden * segment.positions);
+    if (!audition_audio_encode(ctx->ctx_audio, 2, mel.get(), segment.embedding.data()))
+        return pilot_fail(ctx, chunk, "audio_encoder_failed");
+    audit.audio.encoder_ok = 1;
+    audit.audio.encoded_positions = segment.positions;
+    pilot_text(ctx, "<|audio_start|>", chunk, true);
+    p.segments.push_back(std::move(segment));
+    pilot_text(ctx, "<|audio_end|>", chunk, true);
+    if (!text.empty()) {
+        audit.text.expected = audit.text.delivered = 1;
+        pilot_text(ctx, text, chunk, false, "text"); // literal, real tokenizer
+        audit.text.encoded_positions = p.segments.back().positions;
+        if (!audit.text.encoded_positions) return pilot_fail(ctx, chunk, "empty_text_tokens");
+    }
+    ++p.staged_chunks;
+    return true;
+}
+
+static bool pilot_sync_decode(omni_context * ctx) {
+    auto & p = ctx->pilot;
+    if (p.failed) return false;
+    if (!p.initialized || p.committed || p.complete || p.staged_chunks != p.expected_chunks
+            || ctx->n_past != 0 || ctx->async || ctx->duplex_mode || ctx->use_tts)
+        return pilot_fail(ctx, -1, "incomplete_or_dirty_case");
+    pilot_text(ctx, "<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n", -1, true);
+    for (const auto & segment : p.segments) p.input_positions += segment.positions;
+    p.reserved_positions = p.input_positions + p.response_limit;
+    const int64_t effective_ctx = std::min<int64_t>(ctx->params->n_ctx, llama_n_ctx(ctx->ctx_llama));
+    fprintf(stderr, "PILOT_BUDGET {\"input_positions\":%lld,\"text_and_control_positions\":%lld,\"response_reserve\":%d,\"total\":%lld,\"effective_context\":%lld}\n",
+            (long long)p.input_positions, (long long)p.prompt_positions, p.response_limit,
+            (long long)p.reserved_positions, (long long)effective_ctx);
+    // Strictly below: the pinned cache helper would slide at >= n_ctx.
+    if (p.reserved_positions >= effective_ctx)
+        return pilot_fail(ctx, -1, "insufficient_context_before_any_insertion");
+    p.committed = true;
+    for (auto & segment : p.segments) {
+        const int before = ctx->n_past;
+        bool ok = segment.embedding.empty()
+            ? eval_tokens(ctx, ctx->params, segment.tokens, ctx->params->n_batch, &ctx->n_past)
+            : prefill_with_emb(ctx, ctx->params, segment.embedding.data(), segment.positions,
+                               ctx->params->n_batch, &ctx->n_past);
+        if (segment.chunk >= 0 && segment.modality != "control") {
+            auto & c = p.chunks[segment.chunk];
+            auto & count = segment.modality == "image" ? c.image : segment.modality == "audio" ? c.audio : c.text;
+            count.accepted_positions += ctx->n_past - before; // successful batches only
+            count.accepted = count.encoded_positions > 0 && count.accepted_positions == count.encoded_positions
+                             && (segment.modality == "text" || count.encoder_ok);
+        }
+        if (!ok || ctx->n_past - before != segment.positions)
+            return pilot_fail(ctx, segment.chunk, "embedding_or_token_insertion_failed");
+    }
+    for (auto & c : p.chunks) {
+        c.image.accepted = c.image.encoder_ok && c.image.accepted_positions == c.image.encoded_positions;
+        c.audio.accepted = c.audio.encoder_ok && c.audio.accepted_positions == c.audio.encoded_positions;
+        c.text.accepted = c.text.expected && c.text.accepted_positions == c.text.encoded_positions;
+    }
+    p.segments.clear(); // free staged media vectors before autoregressive response
+    for (int i = 0; i < p.response_limit; ++i) {
+        const llama_token token = common_sampler_sample(ctx->ctx_sampler, ctx->ctx_llama, -1);
+        ++p.response_sampled;
+        if (is_end_token(ctx, token)) {
+            p.complete = true;
+            return true;
+        }
+        const int before = ctx->n_past;
+        if (!eval_tokens(ctx, ctx->params, std::vector<llama_token>{token}, 1, &ctx->n_past)
+                || ctx->n_past != before + 1)
+            return pilot_fail(ctx, -1, "response_insertion_failed");
+        common_sampler_accept(ctx->ctx_sampler, token, true);
+        ++p.response_accepted;
+        std::cout << common_token_to_piece(ctx->ctx_llama, token) << std::flush;
+    }
+    return pilot_fail(ctx, -1, "response_budget_exhausted_no_eos");
+}
