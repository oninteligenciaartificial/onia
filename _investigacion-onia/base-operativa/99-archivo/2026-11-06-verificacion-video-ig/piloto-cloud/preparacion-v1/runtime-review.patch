--- /dev/null
+++ b/tools/omni/pilot-state.h
@@ -0,0 +1,45 @@
+#pragma once
+
+// Opt-in audit state. Only the isolated singleplex pilot enables this.
+struct OmniPilotCount {
+    int expected = 0;
+    int decoded = 0;
+    int encoder_ok = 0;
+    int delivered = 0;
+    int accepted = 0;
+    int64_t decoded_samples = 0;
+    int64_t encoded_positions = 0;
+    int64_t accepted_positions = 0;
+};
+
+struct OmniPilotChunk {
+    OmniPilotCount audio, image, text;
+    std::string error;
+};
+
+struct OmniPilotSegment {
+    std::string modality;
+    int chunk = -1;
+    std::vector<llama_token> tokens;
+    std::vector<float> embedding;
+    int positions = 0;
+};
+
+struct OmniPilotState {
+    bool enabled = false;
+    bool initialized = false;
+    bool failed = false;
+    bool committed = false;
+    bool complete = false;
+    int expected_chunks = 0;
+    int staged_chunks = 0;
+    int response_limit = 0;
+    int response_sampled = 0;
+    int response_accepted = 0;
+    int64_t input_positions = 0;
+    int64_t prompt_positions = 0;
+    int64_t reserved_positions = 0;
+    std::string error;
+    std::vector<OmniPilotChunk> chunks;
+    std::vector<OmniPilotSegment> segments;
+};
