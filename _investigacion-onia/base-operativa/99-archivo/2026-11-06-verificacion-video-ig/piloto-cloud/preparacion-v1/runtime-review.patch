+// Each invocation is exactly one case in a fresh context/process.
+static bool run_omni_test(omni_context * ctx, const std::string & prefix,
+                          int count, const std::string & prompt) {
+    ctx->async = false;
+    ctx->pilot.enabled = true;
+    ctx->pilot.expected_chunks = count;
+    ctx->pilot.response_limit = ctx->params->n_predict;
+    if (!stream_prefill(ctx, "", "", 0, -1, "")) return false;
+    for (int chunk = 0; chunk < count; ++chunk) {
+        char number[16];
+        snprintf(number, sizeof(number), "%04d", chunk);
+        const std::string audio = prefix + number + ".wav";
+        const std::string image = prefix + number + ".jpg";
+        if (!file_exists(audio) || !file_exists(image)) {
+            ctx->pilot.failed = true;
+            ctx->pilot.error = "missing_audio_or_image";
+            ctx->pilot.chunks[chunk].error = ctx->pilot.error;
+            return false;
+        }
+        // Literal neutral text is the SIXTH argument, on the last user chunk.
+        if (!stream_prefill(ctx, audio, image, chunk+1, -1,
+                            chunk+1 == count ? prompt : "")) return false;
+    }
+    return stream_decode(ctx, "./", 0);
+}
+
+static void print_count(const char * modality, const OmniPilotCount & c) {
+    fprintf(stderr, "\"%s\":{\"expected\":%d,\"decoded\":%d,\"encoder_ok\":%d,"
+                    "\"delivered\":%d,\"accepted\":%d,\"decoded_samples\":%lld,"
+                    "\"encoded_positions\":%lld,\"accepted_positions\":%lld}",
+            modality,c.expected,c.decoded,c.encoder_ok,c.delivered,c.accepted,
+            (long long)c.decoded_samples,(long long)c.encoded_positions,(long long)c.accepted_positions);
+}
+
+static void print_audit(const omni_context * ctx) {
+    for (size_t i=0;i<ctx->pilot.chunks.size();++i) {
+        const auto & c=ctx->pilot.chunks[i];
+        fprintf(stderr,"PILOT_CHUNK {\"chunk\":%zu,",i);
+        print_count("audio",c.audio); fprintf(stderr,",");
+        print_count("image",c.image); fprintf(stderr,",");
+        print_count("text",c.text);
+        fprintf(stderr,",\"error\":\"%s\"}\n",c.error.c_str());
+    }
+    fprintf(stderr,"PILOT_RESULT {\"complete\":%s,\"error\":\"%s\","
+                   "\"n_past\":%d,\"response_sampled\":%d,\"response_accepted\":%d}\n",
+            ctx->pilot.complete?"true":"false",ctx->pilot.error.c_str(),ctx->n_past,
+            ctx->pilot.response_sampled,ctx->pilot.response_accepted);
+}
+
+static int positive_int(const char * value) {
+    char * end=nullptr;
+    long n=std::strtol(value,&end,10);
+    return end && *value && *end=='\0' && n>0 && n<=1000000 ? (int)n : -1;
+}
