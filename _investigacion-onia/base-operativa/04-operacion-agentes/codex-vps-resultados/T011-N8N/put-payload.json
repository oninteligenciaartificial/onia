    {
      "id": "cd7be66f-b6dd-4b6e-83ea-8fa63be87db6",
      "name": "Extraer novedades",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const NL = String.fromCharCode(10);\nconst raw = ($input.first().json.stdout || \"\").trim();\nlet s;\ntry { s = JSON.parse(raw.split(NL).pop()); } catch (e) { s = { text: \"Radar IA - ERROR: no pude leer la salida.\", notify: true, error: true }; }\n// Decision Sergio 2026-08-28: Telegram avisa SOLO errores. Las novedades quedan en el log\n// del radar (/opt/onia) y en la memoria anti-repeticion; ya no viajan al celular.\nconst notify = s.error === true;\nreturn [{ json: { text: String(s.text || \"(sin contenido)\").slice(0, 3900), notify: notify } }];"
      }
    },
    {
      "id": "fd9d7469-fd24-49bf-982e-ebb1b445a8fe",
      "name": "Hay lanzamiento grande?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
