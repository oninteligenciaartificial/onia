[Unit]
Description=Una pasada acotada de la cola CPU del homelab

[Service]
Type=oneshot
Environment=ONIA_HOMELAB_SSH=0
EnvironmentFile=-%h/operacion/homelab/continuidad-cpu-v1/config.env
ExecStart=/usr/bin/python3 -I -B "%h/operacion/homelab/continuidad-cpu-v1/app/pasada.py" --root "%h/operacion/homelab/cola-cpu-v1" --stop "%h/operacion/homelab/continuidad-cpu-v1/STOP"
TimeoutStartSec=80s
TimeoutStopSec=10s
KillMode=control-group
Restart=no
UMask=0077
Nice=10
CPUQuota=25%
MemoryMax=256M
TasksMax=16
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
StandardOutput=journal
StandardError=journal
