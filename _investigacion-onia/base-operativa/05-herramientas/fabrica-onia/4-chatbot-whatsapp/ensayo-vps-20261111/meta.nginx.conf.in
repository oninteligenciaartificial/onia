# Bloque server propuesto, sin instalar. La prueba lo usa en un nginx propio sin daemon.
# Sustituir los cinco marcadores en una copia privada; no incluir /operador en otro bloque.
server {
    listen @LISTEN@ ssl;
    server_name @SERVER_NAME@;
    ssl_certificate @TLS_CERT@;
    ssl_certificate_key @TLS_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    # Los errores de nginx pueden incluir la query del challenge; no registrarlos aquí.
    error_log /dev/null crit;
    client_max_body_size 256k;
    client_body_buffer_size 256k;
    client_body_timeout 10s;
    server_tokens off;

    location = /meta {
        if ($request_method !~ ^(GET|POST)$) { return 405; }
        # Sin URI, rewrite, proxy_set_body ni reserialización: conserva cuerpo y firma.
        proxy_pass http://127.0.0.1:@ADAPTER_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header Authorization "";
        proxy_request_buffering on;
        proxy_next_upstream off;
        proxy_redirect off;
        proxy_cache off;
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
    }

    location / { return 404; }
}
