USAGE
  $ n8n import:credentials

FLAGS
  -h, --help           Show CLI help
  -i, --input <value>  Input file name or directory if --separate is used
  --separate           Imports *.json files from directory provided by --input [default: false]
  --include <value>    Comma-separated credential properties to include during import
  --exclude <value>    Comma-separated credential properties to exclude during import
  --userId <value>     The ID of the user to assign the imported credentials to
  --projectId <value>  The ID of the project to assign the imported credential to

DESCRIPTION
  Import credentials

EXAMPLES
  $ n8n import:credentials --input=file.json
  $ n8n import:credentials --separate --input=backups/latest/
  $ n8n import:credentials --input=file.json --include=id,name,type,data
  $ n8n import:credentials --input=file.json --exclude=createdAt,updatedAt
  $ n8n import:credentials --input=file.json --userId=1d64c3d2-85fe-4a83-a649-e446b07b3aae
  $ n8n import:credentials --input=file.json --projectId=Ox8O54VQrmBrb4qL
  $ n8n import:credentials --separate --input=backups/latest/ --userId=1d64c3d2-85fe-4a83-a649-e446b07b3aae
